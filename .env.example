# Copy this file to .env and replace every machine-specific placeholder.
# Values are literal KEY=VALUE strings; interpolation is not supported.

# CUDA toolkit root.
PIPELINK_CUDA_HOME=/path/to/cuda
# Writable high-capacity scratch directory.
PIPELINK_SCRATCH_ROOT=/path/to/scratch
# Comma-separated physical GPU indices eligible for measurement.
PIPELINK_GPUS=
# Comma-separated physical GPU indices the lock daemon is authorized to manage.
PIPELINK_LOCKED_GPUS=
# Maximum number of GPU jobs dispatched concurrently.
PIPELINK_MAX_CONCURRENT_GPUS=1
# Calibrated locked SM frequency in MHz; leave empty until calibrated.
PIPELINK_LOCK_SM_MHZ=
# Directory containing lock-daemon state markers.
PIPELINK_LOCK_STATE_DIR=/path/to/lock-state
# Optional checkpoint store root; omit this line to use <repo>/checkpoints.
PIPELINK_CHECKPOINT_ROOT=/path/to/checkpoints
# Keep 0 for the supported locked-clock evaluation path.
PIPELINK_ALLOW_UNLOCKED=0
# Set to 1 to bypass checkpoint lookup and publication.
PIPELINK_NO_CACHE=0
