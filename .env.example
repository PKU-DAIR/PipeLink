# Copy this file to .env and replace every machine-specific placeholder.
# Values are literal KEY=VALUE strings; interpolation is not supported.

# CUDA toolkit root.
PIPELINK_CUDA_HOME=/path/to/cuda
# Writable high-capacity scratch directory.
PIPELINK_SCRATCH_ROOT=/path/to/scratch
# Comma-separated physical GPU indices eligible for measurement.
PIPELINK_GPUS=
# Physical GPU indices the lock daemon may manage; also the default simultaneous qualification set.
PIPELINK_LOCKED_GPUS=
# Maximum number of GPU jobs dispatched concurrently.
PIPELINK_MAX_CONCURRENT_GPUS=1
# ONE qualified SM frequency for every experiment on this machine.
# Leave empty (or 0) to disable clock locking: no sudo is used, gpulockd commands are no-ops,
# and timings are valid only as relative comparisons, not against locked-clock numbers.
# Locked runs require passwordless `sudo nvidia-smi` (for -lgc/-rgc) on every locked GPU.
# Highest supported clock sustained by simultaneous BF16/FP8 GEMMs on all locked GPUs:
# uv run --project tools/clockqual python tools/qualify_clock.py --seconds 60 --confirm-seconds 180 --write-env
# The command backs up .env and saves evidence under out/clock/. Use gpu_window.sh on shared hosts.
PIPELINK_LOCK_SM_MHZ=
# Allowed loaded |clocks.sm - lock| in MHz (default 15). Hardware slowdown always fails.
# SW_POWER_CAP alone is informational, not throttling; idle clock deviation is ignored.
PIPELINK_LOCK_TOLERANCE_MHZ=15
# Directory containing lock-daemon state markers.
PIPELINK_LOCK_STATE_DIR=/path/to/lock-state
# Optional checkpoint store root; omit this line to use <repo>/checkpoints.
PIPELINK_CHECKPOINT_ROOT=/path/to/checkpoints
# Keep 0 for the supported locked-clock evaluation path.
PIPELINK_ALLOW_UNLOCKED=0
# Set to 1 to bypass checkpoint lookup and publication.
PIPELINK_NO_CACHE=0
