{
 "schema": "pipelink-sm90-cells-v1",
 "semantics": {
  "positions": "q, k are 0-based token positions; seqlen_q == seqlen_k (prefill, no offset); h = query head index 0..heads_q-1, kv head = h // (heads_q/heads_kv)",
  "causal": "visible iff k <= q",
  "sliding_window": "visible iff q - window < k <= q (window counts visible keys incl. self; FA window_size_left = window - 1, right = 0)",
  "chunked": "visible iff k <= q and k // chunk == q // chunk",
  "phi3_blocksparse": "qb = q // block, kb = k // block; visible iff k <= q and (qb - kb < local_blocks or (kb + h * head_sliding_step + 1) % vert_stride == 0); per query head h (vLLM/Phi-3-small get_sparse_attn_mask, homo_head=false, head_sliding_step = max(1, vert_stride // heads_q))",
  "msa_selected": "b = q // block; per (q, kv head) the selected block set is {b} U S, S subset of [0, b) distinct, |S| = min(topk - 1, b); prefix: S = lowest min(topk-1, b) blocks; uniform: S drawn without replacement from [0, b) with torch.Generator seeded by `seed`; slots beyond 1 + |S| are padded -1; visible iff block(k) in set and k <= q; the selection is shared by the heads_q/heads_kv query heads of a kv head; the selection is materialized once by `cells.py select <cell>` as a raw little-endian int32 file [heads_kv, seqlen_q, topk] (sorted ascending, -1 padding last) that every implementation, the oracle, the pair counter and the C++ slot consume",
  "softcap": "null = none; else scaled logit x = scale * (q . k) becomes softcap * tanh(x / softcap) before masking and softmax",
  "useful_flops": "4 * head_dim * sum over batch and query heads of visible (q, k) pairs; computed by sm90-baseline/cells.py, shared by every implementation",
  "outputs": "O bf16 [batch, seqlen_q, heads_q, head_dim] and natural-log LSE f32 [batch, heads_q, seqlen_q]",
  "tolerance": {
   "atol": 0.02,
   "rtol": 0.02
  }
 },
