diff --git a/mok/ops.py b/mok/ops.py
--- a/mok/ops.py
+++ b/mok/ops.py
@@ -156,6 +156,48 @@
     return _C.schedule(topk_all, num_local_experts, schedule_capacity, rank)
 
 
+@torch.library.custom_op("mok::schedule_out", mutates_args=(
+    "schedule_peer_rank", "schedule_peer_token_idx", "num_tokens",
+    "tokens_per_expert", "tokens_per_expert_and_peer"))
+def schedule_out(
+    topk_all: torch.Tensor, num_local_experts: int, schedule_capacity: int, rank: int,
+    schedule_peer_rank: torch.Tensor, schedule_peer_token_idx: torch.Tensor,
+    num_tokens: torch.Tensor, tokens_per_expert: torch.Tensor,
+    tokens_per_expert_and_peer: torch.Tensor,
+) -> None:
+    """The original three schedule kernels, writing into caller-owned storage."""
+    if topk_all.ndim != 3 or not topk_all.is_cuda or topk_all.dtype != torch.int32 or not topk_all.is_contiguous():
+        raise ValueError("topk_all must be contiguous CUDA int32 [ep_size, tokens, topk]")
+    world, tokens, topk = topk_all.shape
+    if world not in (1, 4, 8, 16, 32, 64) or tokens < 512 or tokens % 256 or not 0 < topk <= 255:
+        raise ValueError("invalid topk_all dimensions")
+    if num_local_experts <= 0 or not 0 <= rank < world:
+        raise ValueError("invalid local expert count or rank")
+    if schedule_capacity < tokens * topk or schedule_capacity % 256:
+        raise ValueError("invalid schedule capacity")
+    for tensor, size in (
+        (schedule_peer_rank, schedule_capacity),
+        (schedule_peer_token_idx, schedule_capacity),
+        (num_tokens, 1), (tokens_per_expert, num_local_experts),
+        (tokens_per_expert_and_peer, num_local_experts * world),
+    ):
+        if tensor.device != topk_all.device or tensor.dtype != torch.int32 or not tensor.is_contiguous() or tuple(tensor.shape) != (size,):
+            raise ValueError("schedule outputs must be contiguous int32 vectors on the input device with the required extent")
+    _C.schedule_out(topk_all, num_local_experts, schedule_capacity, rank,
+                    schedule_peer_rank, schedule_peer_token_idx, num_tokens,
+                    tokens_per_expert, tokens_per_expert_and_peer)
+
+
+@schedule_out.register_fake
+def _schedule_out_fake(
+    topk_all: torch.Tensor, num_local_experts: int, schedule_capacity: int, rank: int,
+    schedule_peer_rank: torch.Tensor, schedule_peer_token_idx: torch.Tensor,
+    num_tokens: torch.Tensor, tokens_per_expert: torch.Tensor,
+    tokens_per_expert_and_peer: torch.Tensor,
+) -> None:
+    return None
+
+
 @torch.library.custom_op(
     "mok::mxfp8_quantize", mutates_args=(),
     schema="(Tensor x_bf16, bool return_normal, bool return_transposed) -> (Tensor?, Tensor?, Tensor?, Tensor?)",
