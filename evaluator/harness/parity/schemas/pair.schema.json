{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m3-parity-pair-v2",
  "title": "M3 archived attempted pair with adjudicated validity disjunction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "attempt", "order", "device", "protocol", "stream_map_sha256", "stream_classes", "inputs", "arguments", "correctness", "outputs", "telemetry", "original_valid", "original_discard_reasons", "amended_valid", "amended_discard_reasons", "pair_valid", "pair_discard_reasons", "validity_class", "ratio_linked_over_reference"],
  "properties": {
    "schema_version": {"const": "m3-parity-pair-v2"},
    "case_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 0},
    "order": {"type": "array", "prefixItems": [{"enum": ["reference", "linked"]}, {"enum": ["reference", "linked"]}], "minItems": 2, "maxItems": 2, "uniqueItems": true},
    "device": {"type": "object", "required": ["physical_index", "uuid", "pci_bus_id"]},
    "protocol": {"type": "object", "required": ["pair_valid_target"]},
    "stream_map_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stream_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "inputs": {"type": "object"},
    "arguments": {"type": "object"},
    "correctness": {"type": "object", "required": ["reference", "linked"]},
    "outputs": {"type": "object", "required": ["reference", "linked"]},
    "telemetry": {
      "type": "object",
      "required": ["run_median_clock_mhz", "slot_median_clock_mhz", "covering_sample_counts", "common_clock_condition", "common_clock_discard_reasons", "original_valid", "original_discard_reasons", "amended_valid", "amended_discard_reasons", "pair_valid", "pair_discard_reasons", "traces"]
    },
    "original_valid": {"type": "boolean"},
    "original_discard_reasons": {"$ref": "#/$defs/reasons"},
    "amended_valid": {"type": "boolean"},
    "amended_discard_reasons": {"$ref": "#/$defs/reasons"},
    "pair_valid": {"type": "boolean"},
    "pair_discard_reasons": {"$ref": "#/$defs/reasons"},
    "validity_class": {"enum": ["original-valid", "amended-valid", "discarded"]},
    "ratio_linked_over_reference": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "null"}]}
  },
  "$defs": {
    "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
