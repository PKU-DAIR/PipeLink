{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m3-stream-map-v1",
  "title": "M3 canonical Philox stream map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "derivation", "namespace", "namespace_id", "case_encoding", "sharing_policy", "cases", "sha256"],
  "properties": {
    "schema_version": {"const": "m3-stream-map-v1"},
    "derivation": {"type": "object"},
    "namespace": {"enum": ["F1", "F2", "F3", "A-specialization", "A-solver", "A-authoring", "A-F1-continuity", "N-register-coupling", "N-tiny-jit"]},
    "namespace_id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "case_encoding": {"type": "object"},
    "sharing_policy": {"type": "object", "additionalProperties": {"type": "string"}},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "numeric_case", "dimensions", "tensors"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "numeric_case": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "dimensions": {"type": "object"},
          "tensors": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["role_id", "role_name", "class_id", "shape", "strides", "element_count", "dtype", "distribution", "consumers"],
              "properties": {
                "role_id": {"type": "integer", "minimum": 1},
                "role_name": {"type": "string"},
                "class_id": {"type": "string", "pattern": "^ns=0x[0-9a-f]{4}/case=[0-9]+/role=[1-9][0-9]*$"},
                "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
                "strides": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
                "element_count": {"type": "integer", "minimum": 1},
                "dtype": {"enum": ["BF16", "FP16", "FP32", "INT4"]},
                "distribution": {"type": "string"},
                "consumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
